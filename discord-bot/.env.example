# Token-ul botului (Developer Portal -> Bot -> Reset Token). NU îl comite și nu îl trimite nimănui.
DISCORD_TOKEN=

# Opțional: ID-urile serverelor (click dreapta pe server -> Copy Server ID, cu Developer Mode activat).
# Dacă lipsesc, botul recunoaște serverul după nume ("online" / "on-site").
RMI_ONLINE_GUILD_ID=
RMI_ONSITE_GUILD_ID=
